include README.md LICENSE NOTICE.md CITATION.cff CHANGELOG.md requirements-lock.txt verify_all.py
include .gitignore .github/workflows/ci.yml
recursive-include docs *.md
recursive-include examples *.py
recursive-include test *.py
recursive-include bench *.py *.md *.json
